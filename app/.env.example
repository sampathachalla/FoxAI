# Keep disabled until LiveKit/Groq/Deepgram credentials and the Python voice
# worker are running. With this false, Fox uses the existing voice path.
VITE_LIVEKIT_VOICE_ENABLED=false

# API origin. Leave empty for local dev (Vite serves the app on :3000 and
# proxies /api -> :3001). Set it only when the built app is hosted separately
# from the API, e.g. https://fox-api.example.com
VITE_API_URL=

# Dev-only: where Vite's /api proxy forwards. Defaults to http://localhost:3001.
VITE_PROXY_TARGET=

# Planned Picovoice integration; unused until the web code adds its SDK.
VITE_PICOVOICE_ACCESS_KEY=
