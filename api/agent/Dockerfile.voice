FROM python:3.11-slim

WORKDIR /app

# Keep both external runtimes pinned so voice builds are reproducible and an
# upstream update cannot silently change FoxAI behavior.
ARG HERMES_UPSTREAM_REF=v2026.8.27
ARG AGENT_REACH_REF=v1.5.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv \
    && git clone --depth 1 --branch "${HERMES_UPSTREAM_REF}" https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent \
    && uv pip install --system -e "/opt/hermes-agent[edge-tts]" \
    && git clone --depth 1 --branch "${AGENT_REACH_REF}" https://github.com/Panniantong/Agent-Reach.git /opt/agent-reach \
    && uv pip install --system -e /opt/agent-reach \
    && npm install -g mcporter \
    && mcporter config add exa https://mcp.exa.ai/mcp

# Hermes' supported skill source of truth is ~/.hermes/skills. Install the
# English Agent Reach skill plus its references directly from the pinned
# upstream checkout; no FoxAI copy is maintained, so upgrades remain simple.
RUN mkdir -p /root/.hermes/skills/research/agent-reach/references \
    && cp /opt/agent-reach/agent_reach/skill/SKILL_en.md /root/.hermes/skills/research/agent-reach/SKILL.md \
    && cp -r /opt/agent-reach/agent_reach/skill/references/. /root/.hermes/skills/research/agent-reach/references/

ENV HERMES_UPSTREAM_PATH=/opt/hermes-agent \
    HERMES_RUNTIME=auto \
    AGENT_REACH_HOME=/root/.agent-reach

# Install FoxAI voice dependencies in the same image. Upstream Hermes pins its
# own core dependencies; FoxAI adds LiveKit, Groq, Edge and Piper integrations.
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

COPY . .
RUN mkdir -p Tts/piper_models /root/.agent-reach

CMD ["python", "-m", "voice.worker", "dev"]
