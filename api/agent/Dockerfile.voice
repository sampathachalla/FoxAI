FROM python:3.11-slim

WORKDIR /app

# Keep external runtimes pinned so upstream updates cannot silently change
# realtime voice behavior.
ARG HERMES_UPSTREAM_REF=v2026.8.27
ARG AGENT_REACH_REF=v1.5.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv \
    && git clone --depth 1 --branch "${HERMES_UPSTREAM_REF}" https://github.com/NousResearch/hermes-agent.git /opt/hermes-agent \
    && uv pip install --system -e "/opt/hermes-agent[edge-tts]"

ENV HERMES_UPSTREAM_PATH=/opt/hermes-agent \
    HERMES_RUNTIME=auto \
    AGENT_REACH_HOME=/root/.agent-reach \
    AGENT_REACH_ENABLED=true

# Agent Reach is intentionally isolated from the voice/Hermes build logic.
# Docker only invokes its installer; repository/backend/skill details live in
# integrations/agent_reach.
COPY integrations/agent_reach/install.sh /tmp/install-agent-reach.sh
RUN chmod +x /tmp/install-agent-reach.sh \
    && AGENT_REACH_REF="${AGENT_REACH_REF}" /tmp/install-agent-reach.sh \
    && rm /tmp/install-agent-reach.sh

# Install FoxAI voice dependencies in the same image. Upstream Hermes pins its
# own core dependencies; FoxAI adds LiveKit, Groq, Edge and Piper integrations.
COPY requirements.txt .
RUN uv pip install --system -r requirements.txt

COPY . .
RUN mkdir -p Tts/piper_models /root/.agent-reach

CMD ["python", "-m", "voice.worker", "dev"]
