# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN_API_KEY: Required for OpenAI / GPT-5 Nano API calls.
OPEN_API_KEY="MY_OPEN_API_KEY"

# OPENAI_API_KEY: Alternative alias for OpenAI API key.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# DEEPGRAM_API_KEY / deepgram_api_key: Required for Deepgram Aura text-to-speech voice synthesis.
# Configured via AI Studio secrets.
DEEPGRAM_API_KEY="MY_DEEPGRAM_API_KEY"
deepgram_api_key="MY_DEEPGRAM_API_KEY"

# OWN_LLM_API / OWN_LLM_BASE_URL: Required for custom local / self-hosted LLM endpoints.
OWN_LLM_API="MY_OWN_LLM_API_KEY"
OWN_LLM_BASE_URL="https://spry-defensive-snowless.ngrok-free.dev"

