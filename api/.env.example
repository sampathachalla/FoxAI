# GEMINI_API_KEY: Optional compatibility/local Hermes model provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPEN_API_KEY / OPENAI_API_KEY: Optional compatibility/local Hermes model provider.
OPEN_API_KEY="MY_OPEN_API_KEY"
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Realtime voice — listening (Groq Whisper Large v3 Turbo)
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_STT_MODEL="whisper-large-v3-turbo"
VOICE_LANGUAGE="en"
VOICE_MIN_ENDPOINT_MS="450"
VOICE_MAX_ENDPOINT_MS="1200"

# Hermes (hermes container). Hermes' own settings live in deploy/env/hermes.env.
# HERMES_GATEWAY_KEY must match the key Compose gives Hermes (API_SERVER_KEY).
HERMES_URL="http://127.0.0.1:8000"
HERMES_GATEWAY_KEY="fox-dev-only-hermes-key"
VOICE_TTS_URL="http://127.0.0.1:8200"

# Agent Reach (web research) is installed into Hermes; its search policy is in
# agents/hermes/SOUL.md.

# Realtime voice — speaking. Edge is the default; Piper is local/offline.
# Deepgram remains optional and can still be selected from the frontend.
VOICE_TTS_PROVIDER="edge"
VOICE_TTS_FIRST_PHRASE_MIN_CHARS="24"
VOICE_TTS_FIRST_PHRASE_MAX_CHARS="96"
VOICE_TTS_PHRASE_MIN_CHARS="44"
VOICE_TTS_PHRASE_MAX_CHARS="180"
DEEPGRAM_API_KEY="MY_DEEPGRAM_API_KEY"
DEEPGRAM_TTS_MODEL="aura-2-thalia-en"

# LiveKit WebRTC transport
LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY="MY_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="MY_LIVEKIT_API_SECRET"

# OWN_LLM_API / OWN_LLM_BASE_URL: custom local / self-hosted LLM endpoint.
OWN_LLM_API="MY_OWN_LLM_API_KEY"
OWN_LLM_BASE_URL="https://example.ngrok-free.dev"

# OpenWakeWord / Fox wake-word service (optional activation layer)
WAKEWORD_ENABLED="true"
WAKEWORD_SERVICE_URL="http://127.0.0.1:8011"
WAKEWORD_PUBLIC_WS_URL="ws://127.0.0.1:8011/ws"
WAKEWORD_PORT="8011"
WAKEWORD_PHRASE="Hey Jarvis"
WAKEWORD_MODEL_KEY="hey jarvis"
WAKEWORD_MODEL_PATH=""
WAKEWORD_THRESHOLD="0.5"
WAKEWORD_COOLDOWN_SECONDS="3.0"
