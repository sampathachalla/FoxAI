# Grafana login for the observability dashboard (http://localhost:3100).
# Without this file Grafana falls back to admin/admin and asks for a new
# password on first login.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Optional: send the observability container's own component logs to stdout
# (useful when debugging the collector). See github.com/grafana/docker-otel-lgtm.
# ENABLE_LOGS_OTELCOL=true
